// This file is automatically generated by Keystone, do not modify it manually.
// Modify your Keystone config when you want to change this.

datasource sqlite {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String  @id @default(cuid())
  username         String  @default("")
  displayName      String  @default("")
  email            String  @unique @default("")
  password         String
  isAdmin          Boolean @default(false)
  from_Post_author Post[]  @relation("Post_author")
}

model Post {
  id                               String            @id @default(cuid())
  title                            String            @default("")
  postType                         String?           @default("standalone")
  publishedAt                      DateTime          @default(now())
  lastModified                     DateTime?         @default(now())
  author                           User?             @relation("Post_author", fields: [authorId], references: [id])
  authorId                         String?           @map("author")
  brief                            String            @default("")
  content                          String            @default("[{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]}]")
  category                         Category?         @relation("Post_category", fields: [categoryId], references: [id])
  categoryId                       String?           @map("category")
  headerImage                      Image?            @relation("Post_headerImage", fields: [headerImageId], references: [id])
  headerImageId                    String?           @map("headerImage")
  status                           String?           @default("draft")
  page                             Page[]            @relation("Post_page")
  tags                             Tag[]             @relation("Post_tags")
  series                           StoryCollection?  @relation("Post_series", fields: [seriesId], references: [id])
  seriesId                         String?           @map("series")
  seriesOrder                      Int?
  url                              String            @unique @default("")
  from_StoryCollection_seriesPosts StoryCollection[] @relation("StoryCollection_seriesPosts")

  @@index([authorId])
  @@index([categoryId])
  @@index([headerImageId])
  @@index([seriesId])
}

model Category {
  id                 String @id @default(cuid())
  name               String @unique @default("")
  description        String @unique @default("")
  from_Post_category Post[] @relation("Post_category")
}

model Tag {
  id             String @id @default(cuid())
  name           String @unique @default("")
  tag            String @unique @default("")
  description    String @unique @default("")
  from_Post_tags Post[] @relation("Post_tags")
}

model StoryCollection {
  id                        String  @id @default(cuid())
  title                     String  @unique @default("")
  socialMediaBrief          String  @default("")
  synopsis                  String  @default("[{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]}]")
  seriesPosts               Post[]  @relation("StoryCollection_seriesPosts")
  url                       String  @unique @default("")
  status                    String? @default("draft")
  from_Post_series          Post[]  @relation("Post_series")
  from_Page_storyCollection Page[]  @relation("Page_storyCollection")
}

model Page {
  id                String           @id @default(cuid())
  title             String           @unique @default("")
  pageOrder         Int?
  pageType          String?          @default("standard")
  socialMediaBrief  String           @default("")
  content           String           @default("[{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]}]")
  barcode           String           @default("")
  postSections      String           @default("")
  status            String?          @default("draft")
  showInNav         Boolean          @default(false)
  url               String           @unique @default("")
  storyCollection   StoryCollection? @relation("Page_storyCollection", fields: [storyCollectionId], references: [id])
  storyCollectionId String?          @map("storyCollection")
  from_Post_page    Post[]           @relation("Post_page")

  @@index([storyCollectionId])
}

model Image {
  id                    String  @id @default(cuid())
  name                  String  @default("")
  altText               String  @default("")
  image_id              String?
  image_filesize        Int?
  image_width           Int?
  image_height          Int?
  image_extension       String?
  from_Post_headerImage Post[]  @relation("Post_headerImage")
}
